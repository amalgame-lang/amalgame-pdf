namespace Amalgame.Formats.Pdf

import Amalgame.Collections
import Amalgame.String
import Amalgame.Crypto

// ═══════════════════════════════════════════════════════════════════════
//  amalgame-pdf — générateur PDF 1.4 souverain, pur Amalgame
// ═══════════════════════════════════════════════════════════════════════
//
// Écrit un document PDF d'une page (suffisant pour factures, reçus, bons).
// Aucune dépendance externe : polices standard PDF (Helvetica / Helvetica-Bold,
// pas d'embarquement) et embarquement d'images JPEG (filtre DCTDecode).
//
// Repère : l'API expose des coordonnées en points, origine **coin haut-gauche**
// (y vers le bas — comme à l'écran) ; la conversion vers le repère PDF natif
// (origine bas-gauche) est faite en interne. Tout est en entiers (points).
//
// Texte encodé en WinAnsi (Latin-1 + € et guillemets typographiques) — couvre
// le français ; les caractères hors table deviennent « ? ».
//
// Surface :
//   Pdf.A4Portrait() / A4Landscape() / New(wPts, hPts)
//   Text / TextBold / TextColor / TextBoldColor(x, yTop, size, s [, rgb])
//   TextRight / TextRightBold / TextRightColor(xRight, yTop, size, s [, rgb])
//   Line(x1, y1, x2, y2, widthPts)
//   Rect(x, yTop, w, h, widthPts)                 (contour)
//   FillRect(x, yTop, w, h, rgb)                  (rempli)
//   TextWidth(size, s) -> int                     (largeur en points)
//   AddJpeg(bytes, wPx, hPx) -> int (handle)  /  DrawImage(handle, x, yTop, w, h)
//   Build() -> List<int>                          (octets du PDF)

public class PdfImage {
    public Data: List<int>
    public W:    int
    public H:    int
    public Cs:   string        // espace colorimétrique PDF (DeviceGray/RGB/CMYK)
    public PdfImage() { this.Data = new List<int>(); this.W = 0; this.H = 0; this.Cs = "DeviceRGB" }
}

public class Pdf {
    public Wd:      int
    public Ht:      int
    public Content: List<int>
    public Images:  List<PdfImage>
    // Pages déjà closes (voir NewPage()) — Content porte toujours la
    // page COURANTE, encore ouverte. Build() ajoute Content à la fin
    // de cette liste au moment de sérialiser, donc un document jamais
    // touché par NewPage() reste un simple document 1 page (aucun
    // changement de comportement pour le code existant v0.1).
    public Pages: List<List<int>>

    public Pdf() {
        this.Wd = 595
        this.Ht = 842
        this.Content = new List<int>()
        this.Images = new List<PdfImage>()
        this.Pages = new List<List<int>>()
    }

    // Clôt la page courante et en ouvre une nouvelle, même taille
    // (Wd/Ht) — un document multi-page reste une seule taille de page,
    // suffisant pour une édition/un rapport (pas de mélange portrait/
    // paysage dans un même document, cas pas rencontré ici).
    public void NewPage() {
        this.Pages.Add(this.Content)
        this.Content = new List<int>()
    }

    public static Pdf New(int wPts, int hPts) {
        let p = new Pdf()
        p.Wd = wPts
        p.Ht = hPts
        return p
    }
    public static Pdf A4Portrait()  { return Pdf.New(595, 842) }
    public static Pdf A4Landscape() { return Pdf.New(842, 595) }

    // ── octets bas niveau ───────────────────────────────────────────────
    private static void putAscii(List<int> buf, string s) {
        let b: List<int> = Bytes.FromString(s)
        for i in 0..b.Count() { buf.Add(b.Get(i)) }
    }
    private static void putBytes(List<int> buf, List<int> src) {
        for i in 0..src.Count() { buf.Add(src.Get(i)) }
    }

    private void emit(string s) { Pdf.putAscii(this.Content, s) }

    // fraction 0..255 → décimale "0.xxx" / "1" / "0" pour les opérateurs couleur.
    private static string frac255(int c) {
        if (c <= 0) { return "0" }
        if (c >= 255) { return "1" }
        let t: int = c * 1000 / 255
        let h: int = t / 100
        let rem: int = t % 100
        let te: int = rem / 10
        let on: int = rem % 10
        return "0." + String_FromInt(h) + String_FromInt(te) + String_FromInt(on)
    }
    private static string rgbStr(int rgb) {
        let r: int = (rgb / 65536) % 256
        let g: int = (rgb / 256) % 256
        let b: int = rgb % 256
        return Pdf.frac255(r) + " " + Pdf.frac255(g) + " " + Pdf.frac255(b)
    }

    // ── encodage WinAnsi ────────────────────────────────────────────────
    private static int cpToWinAnsi(int cp) {
        if (cp < 128) { return cp }
        if (cp == 0x20AC) { return 0x80 }     // €
        if (cp == 0x2018) { return 0x91 }     // ‘
        if (cp == 0x2019) { return 0x92 }     // ’
        if (cp == 0x201C) { return 0x93 }     // “
        if (cp == 0x201D) { return 0x94 }     // ”
        if (cp == 0x2013) { return 0x96 }     // –
        if (cp == 0x2014) { return 0x97 }     // —
        if (cp == 0x0152) { return 0x8C }     // Œ
        if (cp == 0x0153) { return 0x9C }     // œ
        if (cp >= 0xA0 && cp <= 0xFF) { return cp }  // Latin-1 = WinAnsi
        return 0x3F                            // '?'
    }
    // UTF-8 → octets WinAnsi.
    private static List<int> winansi(string s) {
        let u: List<int> = Bytes.FromString(s)
        let out = new List<int>()
        var i: int = 0
        let n: int = u.Count()
        while (i < n) {
            let b: int = u.Get(i)
            if (b < 0x80) {
                out.Add(b)
                i = i + 1
            } else if (b >= 0xC0 && b < 0xE0 && i + 1 < n) {
                let cp: int = ((b & 0x1F) << 6) | (u.Get(i + 1) & 0x3F)
                out.Add(Pdf.cpToWinAnsi(cp))
                i = i + 2
            } else if (b >= 0xE0 && b < 0xF0 && i + 2 < n) {
                let cp: int = ((b & 0x0F) << 12) | ((u.Get(i + 1) & 0x3F) << 6) | (u.Get(i + 2) & 0x3F)
                out.Add(Pdf.cpToWinAnsi(cp))
                i = i + 3
            } else if (b >= 0xF0 && i + 3 < n) {
                out.Add(0x3F)
                i = i + 4
            } else {
                out.Add(0x3F)
                i = i + 1
            }
        }
        return out
    }
    // Échappe ( ) \ dans une chaîne littérale PDF.
    private static List<int> escLit(List<int> wa) {
        let out = new List<int>()
        for i in 0..wa.Count() {
            let b: int = wa.Get(i)
            if (b == 0x28 || b == 0x29 || b == 0x5C) { out.Add(0x5C) }
            out.Add(b)
        }
        return out
    }

    // ── polices embarquées (v0.3) ──────────────────────────────────────
    // Liberation Sans (SIL Open Font License, vendor/OFL.txt) — vendorisée
    // en octets bruts dans facade-stub.h (vendor/liberation_sans_*.h,
    // generes via un simple `xxd -i`-like) et parsee UNE FOIS par
    // processus (cache C, vendor/ttf_parse.h) pour ses vraies metriques
    // (largeurs par octet WinAnsi via cmap+hmtx, ascent/descent/bbox via
    // head+hhea) — remplace a la fois l'ancienne approximation charW()
    // (largeurs desormais REELLES, pas une moyenne par categorie de
    // caractere) ET l'absence d'embarquement (le fichier de police
    // COMPLET, kLiberationSansRegular/Bold, est copie tel quel dans
    // /FontFile2 au moment de Build() — voir plus bas). fontId : 0 =
    // Regular (F1), 1 = Bold (F2).
    private static int ttfLen(int fontId) {
        var result: int = 0
        @c { result = (fontId == 0) ? (int)kLiberationSansRegularLen : (int)kLiberationSansBoldLen; }
        return result
    }
    private static int ttfByteAt(int fontId, int i) {
        var result: int = 0
        @c { result = (fontId == 0) ? (int)kLiberationSansRegular[i] : (int)kLiberationSansBold[i]; }
        return result
    }
    // Largeur reelle (unites/1000em) d'un octet WinAnsi, 0 si le glyphe
    // n'existe pas dans la police (jamais le cas pour WinAnsi complet
    // avec Liberation Sans, gardee en filet de securite quand meme).
    private static int ttfWidthAt(int fontId, int code) {
        var result: int = 0
        @c {
            TtfMetrics* m = ttf_get((int)fontId);
            result = m ? m->widths[(int)code] : 0;
        }
        return result
    }
    // which : 0=ascent 1=descent 2=capHeight 3=bboxX0 4=bboxY0 5=bboxX1 6=bboxY1
    private static int ttfMetric(int fontId, int which) {
        var result: int = 0
        @c {
            TtfMetrics* m = ttf_get((int)fontId);
            if (m) {
                int w = (int)which;
                if (w == 0) { result = m->ascent; }
                else if (w == 1) { result = m->descent; }
                else if (w == 2) { result = m->cap_height; }
                else if (w == 3) { result = m->bbox_x0; }
                else if (w == 4) { result = m->bbox_y0; }
                else if (w == 5) { result = m->bbox_x1; }
                else if (w == 6) { result = m->bbox_y1; }
            }
        }
        return result
    }

    // ── métriques Helvetica (approx, /1000 em) — filet de sécurité si
    // ttfWidthAt renvoie 0 (glyphe absent), plus la voie principale
    // depuis v0.3 (voir TextWidth juste en dessous). ─────────────────
    private static int charW(int b) {
        if (b == 32) { return 278 }                 // espace
        if (b >= 48 && b <= 57) { return 556 }      // chiffres
        if (b == 46 || b == 44) { return 278 }      // . ,
        if (b == 58 || b == 59) { return 278 }      // : ;
        if (b == 40 || b == 41) { return 333 }      // ( )
        if (b == 45) { return 333 }                 // -
        if (b == 47) { return 278 }                 // /
        if (b == 0x80) { return 556 }               // €
        if (b == 105 || b == 108 || b == 106) { return 222 }  // i l j
        if (b == 102 || b == 116) { return 278 }    // f t
        if (b == 114) { return 333 }                // r
        if (b == 73) { return 278 }                 // I
        if (b >= 65 && b <= 90) { return 667 }      // majuscules (moy.)
        if (b >= 97 && b <= 122) { return 556 }     // minuscules (moy.)
        return 556
    }
    public int TextWidth(int size, string s) {
        let wa: List<int> = Pdf.winansi(s)
        var sum: int = 0
        for i in 0..wa.Count() {
            let code: int = wa.Get(i)
            var w: int = Pdf.ttfWidthAt(0, code)
            if (w == 0) { w = Pdf.charW(code) }
            sum = sum + w
        }
        return sum * size / 1000
    }

    // ── retour à la ligne automatique (v0.2) ──────────────────────────
    // Découpe un paragraphe (sans \n) en lignes tenant dans `width` pts
    // à `size` — glouton, coupe aux espaces ; un mot seul plus large que
    // `width` est coupé brut (caractère par caractère) plutôt que de
    // déborder indéfiniment. Mesure via TextWidth (métriques Helvetica
    // déjà en place) — même police que le rendu réel, donc les mêmes
    // largeurs.
    private void wrapParagraph(List<string> lines, int width, int size, string para) {
        if (String_Length(para) == 0) { lines.Add(""); return }
        let n: int = String_Length(para)
        var lineStart: int = 0
        var lastSpace: int = -1
        var i: int = 0
        while (i < n) {
            if (String_CharAt1(para, i) == " ") { lastSpace = i }
            let candidate: string = String_Substring(para, lineStart, i - lineStart + 1)
            if (this.TextWidth(size, candidate) > width && i > lineStart) {
                if (lastSpace >= lineStart) {
                    lines.Add(String_Substring(para, lineStart, lastSpace - lineStart))
                    lineStart = lastSpace + 1
                    lastSpace = -1
                } else {
                    lines.Add(String_Substring(para, lineStart, i - lineStart))
                    lineStart = i
                }
            }
            i = i + 1
        }
        if (lineStart < n) { lines.Add(String_Substring(para, lineStart, n - lineStart)) }
    }

    // Découpe `text` (peut contenir des \n — un par saut de paragraphe
    // volontaire) en lignes tenant dans `width` pts à `size`. Pur —
    // aucun dessin, juste le calcul, réutilisable indépendamment de
    // Flow (ex. compter les lignes pour équilibrer des colonnes avant
    // de dessiner quoi que ce soit).
    public List<string> WrapText(int width, int size, string text) {
        var lines: List<string> = new List<string>()
        let n: int = String_Length(text)
        var paraStart: int = 0
        var i: int = 0
        while (i <= n) {
            if (i == n || String_CharAt1(text, i) == "\n") {
                this.wrapParagraph(lines, width, size, String_Substring(text, paraStart, i - paraStart))
                paraStart = i + 1
            }
            i = i + 1
        }
        return lines
    }

    // Dessine `text` (word-wrappé via WrapText) en colonne à partir de
    // (x, yTop), une ligne tous les `lineHeight` pts, jusqu'à `bottomLimit`
    // (y en dessous duquel on ne dessine plus). Renvoie le texte NON
    // dessiné (chaîne vide si tout tenait) — à l'appelant de décider quoi
    // en faire (NewPage() + rappeler Flow avec ce reste, colonne
    // suivante...) : amalgame-pdf reste une primitive de dessin, pas un
    // moteur de mise en page multi-colonnes/multi-page — cette décision
    // est spécifique à chaque document (voir CMSPress, édition hebdo).
    // Limite connue : si la coupure tombe exactement sur une frontière de
    // paragraphe, le \n d'origine est perdu (les lignes restantes sont
    // rejointes par un simple espace) — cas limite rare, pas corrigé en
    // v0.2 pour rester simple.
    private string flowImpl(int x, int yTop, int width, int size, int lineHeight, string text, int bottomLimit, bool bold) {
        let lines: List<string> = this.WrapText(width, size, text)
        var y: int = yTop
        var i: int = 0
        while (i < lines.Count()) {
            if (y + lineHeight > bottomLimit) {
                var rest: string = ""
                var j: int = i
                while (j < lines.Count()) {
                    if (String_Length(rest) > 0) { rest = rest + " " }
                    rest = rest + lines.Get(j)
                    j = j + 1
                }
                return rest
            }
            this.emitText(x, y, size, lines.Get(i), bold, 0)
            y = y + lineHeight
            i = i + 1
        }
        return ""
    }
    public string Flow(int x, int yTop, int width, int size, int lineHeight, string text, int bottomLimit) {
        return this.flowImpl(x, yTop, width, size, lineHeight, text, bottomLimit, false)
    }
    public string FlowBold(int x, int yTop, int width, int size, int lineHeight, string text, int bottomLimit) {
        return this.flowImpl(x, yTop, width, size, lineHeight, text, bottomLimit, true)
    }

    // ── texte ────────────────────────────────────────────────────────────
    private void emitText(int x, int yTop, int size, string s, bool bold, int rgb) {
        let y: int = this.Ht - yTop
        var font: string = "/F1"
        if (bold) { font = "/F2" }
        this.emit(Pdf.rgbStr(rgb) + " rg BT " + font + " " + String_FromInt(size)
            + " Tf " + String_FromInt(x) + " " + String_FromInt(y) + " Td (")
        Pdf.putBytes(this.Content, Pdf.escLit(Pdf.winansi(s)))
        this.emit(") Tj ET\n")
    }
    public void Text(int x, int yTop, int size, string s)          { this.emitText(x, yTop, size, s, false, 0) }
    public void TextBold(int x, int yTop, int size, string s)      { this.emitText(x, yTop, size, s, true, 0) }
    public void TextColor(int x, int yTop, int size, string s, int rgb)     { this.emitText(x, yTop, size, s, false, rgb) }
    public void TextBoldColor(int x, int yTop, int size, string s, int rgb) { this.emitText(x, yTop, size, s, true, rgb) }
    public void TextRight(int xRight, int yTop, int size, string s) {
        this.emitText(xRight - this.TextWidth(size, s), yTop, size, s, false, 0)
    }
    public void TextRightBold(int xRight, int yTop, int size, string s) {
        this.emitText(xRight - this.TextWidth(size, s), yTop, size, s, true, 0)
    }
    public void TextRightColor(int xRight, int yTop, int size, string s, int rgb) {
        this.emitText(xRight - this.TextWidth(size, s), yTop, size, s, false, rgb)
    }

    // ── vecteurs ──────────────────────────────────────────────────────────
    public void Line(int x1, int y1Top, int x2, int y2Top, int widthPts) {
        let y1: int = this.Ht - y1Top
        let y2: int = this.Ht - y2Top
        this.emit(String_FromInt(widthPts) + " w 0 0 0 RG "
            + String_FromInt(x1) + " " + String_FromInt(y1) + " m "
            + String_FromInt(x2) + " " + String_FromInt(y2) + " l S\n")
    }
    public void LineColor(int x1, int y1Top, int x2, int y2Top, int widthPts, int rgb) {
        let y1: int = this.Ht - y1Top
        let y2: int = this.Ht - y2Top
        this.emit(String_FromInt(widthPts) + " w " + Pdf.rgbStr(rgb) + " RG "
            + String_FromInt(x1) + " " + String_FromInt(y1) + " m "
            + String_FromInt(x2) + " " + String_FromInt(y2) + " l S\n")
    }
    public void Rect(int x, int yTop, int w, int h, int widthPts) {
        let y: int = this.Ht - yTop - h
        this.emit(String_FromInt(widthPts) + " w 0 0 0 RG "
            + String_FromInt(x) + " " + String_FromInt(y) + " "
            + String_FromInt(w) + " " + String_FromInt(h) + " re S\n")
    }
    public void FillRect(int x, int yTop, int w, int h, int rgb) {
        let y: int = this.Ht - yTop - h
        this.emit(Pdf.rgbStr(rgb) + " rg "
            + String_FromInt(x) + " " + String_FromInt(y) + " "
            + String_FromInt(w) + " " + String_FromInt(h) + " re f\n")
    }

    // ── images JPEG (DCTDecode) ───────────────────────────────────────────
    public int AddJpeg(List<int> jpeg, int wPx, int hPx) {
        let im = new PdfImage()
        im.Data = jpeg
        im.W = wPx
        im.H = hPx
        im.Cs = Pdf.jpegColorSpace(jpeg)
        this.Images.Add(im)
        return this.Images.Count() - 1
    }

    // Détermine l'espace colorimétrique d'un JPEG via le marqueur SOF
    // (nombre de composantes : 1=Gray, 3=RGB, 4=CMYK). Défaut RGB.
    private static string jpegColorSpace(List<int> d) {
        var i: int = 2
        let n: int = d.Count()
        while (i + 9 < n) {
            if (d.Get(i) != 0xFF) { i = i + 1; continue }
            let m: int = d.Get(i + 1)
            if (m == 0xD8 || m == 0xD9) { i = i + 2; continue }
            if (m >= 0xD0 && m <= 0xD7) { i = i + 2; continue }
            let len: int = d.Get(i + 2) * 256 + d.Get(i + 3)
            if (m == 0xC0 || m == 0xC1 || m == 0xC2 || m == 0xC3) {
                let comps: int = d.Get(i + 9)
                if (comps == 1) { return "DeviceGray" }
                if (comps == 4) { return "DeviceCMYK" }
                return "DeviceRGB"
            }
            i = i + 2 + len
        }
        return "DeviceRGB"
    }
    public void DrawImage(int handle, int x, int yTop, int w, int h) {
        let y: int = this.Ht - yTop - h
        this.emit("q " + String_FromInt(w) + " 0 0 " + String_FromInt(h) + " "
            + String_FromInt(x) + " " + String_FromInt(y) + " cm /Im"
            + String_FromInt(handle) + " Do Q\n")
    }

    // ── sérialisation ──────────────────────────────────────────────────────
    private static string pad10(int n) {
        var s: string = String_FromInt(n)
        while (String_Length(s) < 10) { s = "0" + s }
        return s
    }

    // Émet un objet Font TrueType embarqué complet (dict + FontDescriptor
    // + FontFile2) — factorisé, appelé une fois par poids (F1/F2) depuis
    // Build(). /FirstChar 0 /LastChar 255 : couvre tout WinAnsi, un seul
    // tableau /Widths, pas de sous-classement par plage utilisée (le
    // fichier de police lui-même n'est de toute façon PAS sous-ensemblé
    // -- voir la limite documentée dans le README -- donc pas de gain à
    // sous-ensembler juste le tableau de largeurs).
    // /Flags 32 = Nonsymbolic (jeu de caractères standard Latin, cohérent
    // avec /Encoding /WinAnsiEncoding). StemV approximé (80 normal, 120
    // gras) -- OS/2.usWeightClass non lu, cette valeur n'est qu'un indice
    // de rendu pour le lecteur, jamais utilisée pour la lisibilité de
    // base des glyphes eux-mêmes (déjà dans le programme de police
    // embarqué, inchangé).
    private static void emitEmbeddedFont(List<int> out, List<int> offsets,
            int fontObj, int descObj, int fileObj, int fontId, string baseFontName) {
        var widthsStr: string = "["
        var c: int = 0
        while (c < 256) {
            var w: int = Pdf.ttfWidthAt(fontId, c)
            if (w == 0) { w = Pdf.charW(c) }
            widthsStr = widthsStr + String_FromInt(w) + " "
            c = c + 1
        }
        widthsStr = widthsStr + "]"

        let ascent: int = Pdf.ttfMetric(fontId, 0)
        let descent: int = Pdf.ttfMetric(fontId, 1)
        let capHeight: int = Pdf.ttfMetric(fontId, 2)
        let bboxX0: int = Pdf.ttfMetric(fontId, 3)
        let bboxY0: int = Pdf.ttfMetric(fontId, 4)
        let bboxX1: int = Pdf.ttfMetric(fontId, 5)
        let bboxY1: int = Pdf.ttfMetric(fontId, 6)
        var stemV: int = 80
        if (fontId == 1) { stemV = 120 }

        // NB : chaque chaîne ci-dessous est bâtie en plusieurs étapes via
        // des variables intermédiaires (jamais un unique `+` géant) --
        // trouvé empiriquement : gcc -O2 (avec inlining actif, celui
        // qu'utilise amc) élimine silencieusement un littéral profondément
        // imbriqué (ex. "/FontFile2") d'une chaîne à 20+ niveaux de
        // code_string_concat imbriqués -- le littéral disparaît des octets
        // compilés (confirmé via -fno-inline, qui seul le préserve), sans
        // aucune erreur de compilation. Même famille de piège que les
        // .Get().Get() déjà documentés dans ce repo, cette fois côté gcc/
        // codegen plutôt qu'amc lui-même. Découper la chaîne en petits
        // morceaux (2-4 `+` par variable) contourne le problème.
        offsets.Set(fontObj, out.Count())
        var fontDict: string = String_FromInt(fontObj) + " 0 obj\n<< /Type /Font /Subtype /TrueType"
        fontDict = fontDict + " /BaseFont /" + baseFontName + " /FirstChar 0 /LastChar 255"
        fontDict = fontDict + " /Widths " + widthsStr
        fontDict = fontDict + " /FontDescriptor " + String_FromInt(descObj) + " 0 R"
        fontDict = fontDict + " /Encoding /WinAnsiEncoding >>\nendobj\n"
        Pdf.putAscii(out, fontDict)

        offsets.Set(descObj, out.Count())
        var descDict: string = String_FromInt(descObj) + " 0 obj\n<< /Type /FontDescriptor"
        descDict = descDict + " /FontName /" + baseFontName + " /Flags 32"
        descDict = descDict + " /FontBBox [" + String_FromInt(bboxX0) + " " + String_FromInt(bboxY0)
        descDict = descDict + " " + String_FromInt(bboxX1) + " " + String_FromInt(bboxY1) + "]"
        descDict = descDict + " /ItalicAngle 0 /Ascent " + String_FromInt(ascent)
        descDict = descDict + " /Descent " + String_FromInt(descent)
        descDict = descDict + " /CapHeight " + String_FromInt(capHeight)
        descDict = descDict + " /StemV " + String_FromInt(stemV)
        let fontFileRef: string = " /FontFile2 " + String_FromInt(fileObj) + " 0 R >>\nendobj\n"
        descDict = descDict + fontFileRef
        Pdf.putAscii(out, descDict)

        let len: int = Pdf.ttfLen(fontId)
        offsets.Set(fileObj, out.Count())
        var fileDict: string = String_FromInt(fileObj) + " 0 obj\n<< /Length " + String_FromInt(len)
        fileDict = fileDict + " /Length1 " + String_FromInt(len) + " >>\nstream\n"
        Pdf.putAscii(out, fileDict)
        var i: int = 0
        while (i < len) {
            out.Add(Pdf.ttfByteAt(fontId, i))
            i = i + 1
        }
        Pdf.putAscii(out, "\nendstream\nendobj\n")
    }

    // Numérotation d'objets (v0.3, polices embarquées) — calculée :
    //   1            Catalog
    //   2            Pages (parent)
    //   3 + 2*i      Page n°i       (i = 0..nPages-1)
    //   3 + 2*i + 1  Contents n°i   (stream de la page i)
    //   base             Font F1 (dict, /Type /Font /Subtype /TrueType)
    //   base + 1         FontDescriptor F1
    //   base + 2         FontFile2 F1 (stream — octets bruts de la police)
    //   base + 3         Font F2
    //   base + 4         FontDescriptor F2
    //   base + 5         FontFile2 F2
    //   base + 6 ..      Images (partagées par TOUTES les pages — un
    //                    /Resources /XObject peut lister plus d'images
    //                    que ce qu'une page donnée dessine réellement,
    //                    valide selon le spec PDF ; plus simple que de
    //                    calculer quelles images sont utilisées sur
    //                    quelle page).
    public List<int> Build() {
        let out = new List<int>()
        var allPages: List<List<int>> = new List<List<int>>()
        for i in 0..this.Pages.Count() { allPages.Add(this.Pages.Get(i)) }
        allPages.Add(this.Content)
        let nPages: int = allPages.Count()
        let nImg: int = this.Images.Count()
        let base: int = 3 + 2 * nPages
        let fontF1: int = base
        let descF1: int = base + 1
        let fileF1: int = base + 2
        let fontF2: int = base + 3
        let descF2: int = base + 4
        let fileF2: int = base + 5
        let imgBase: int = base + 6
        let total: int = imgBase + nImg - 1
        let offsets = new List<int>()
        for i in 0..total + 1 { offsets.Add(0) }

        Pdf.putAscii(out, "%PDF-1.4\n")
        // marqueur binaire
        out.Add(0x25); out.Add(0xE2); out.Add(0xE3); out.Add(0xCF); out.Add(0xD3); out.Add(0x0A)

        // obj 1 : Catalog
        offsets.Set(1, out.Count())
        Pdf.putAscii(out, "1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n")

        // obj 2 : Pages
        var kids: string = ""
        for i in 0..nPages { kids = kids + String_FromInt(3 + 2 * i) + " 0 R " }
        offsets.Set(2, out.Count())
        Pdf.putAscii(out, "2 0 obj\n<< /Type /Pages /Kids [" + kids + "] /Count "
            + String_FromInt(nPages) + " >>\nendobj\n")

        // /Resources partagé (mêmes polices + mêmes images sur toutes
        // les pages) — recalculé une fois, réutilisé pour chaque page.
        var xobj: string = ""
        if (nImg > 0) {
            xobj = " /XObject <<"
            for i in 0..nImg { xobj = xobj + " /Im" + String_FromInt(i) + " " + String_FromInt(imgBase + i) + " 0 R" }
            xobj = xobj + " >>"
        }
        let resources: string = " /Resources << /Font << /F1 " + String_FromInt(fontF1)
            + " 0 R /F2 " + String_FromInt(fontF2) + " 0 R >>" + xobj + " >>"

        // obj 3+2i / 3+2i+1 : Page i / Contents i
        var p: int = 0
        while (p < nPages) {
            let pageObj: int = 3 + 2 * p
            let contObj: int = pageObj + 1
            let content: List<int> = allPages.Get(p)
            offsets.Set(pageObj, out.Count())
            Pdf.putAscii(out, String_FromInt(pageObj) + " 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 "
                + String_FromInt(this.Wd) + " " + String_FromInt(this.Ht) + "]" + resources
                + " /Contents " + String_FromInt(contObj) + " 0 R >>\nendobj\n")
            offsets.Set(contObj, out.Count())
            Pdf.putAscii(out, String_FromInt(contObj) + " 0 obj\n<< /Length " + String_FromInt(content.Count())
                + " >>\nstream\n")
            Pdf.putBytes(out, content)
            Pdf.putAscii(out, "\nendstream\nendobj\n")
            p = p + 1
        }

        // polices embarquées (v0.3) — F1 = Liberation Sans (fontId=0),
        // F2 = Liberation Sans Bold (fontId=1). Widths[c] pour c=0..31
        // (control chars, jamais dessinés par emitText en pratique mais
        // le tableau doit couvrir FirstChar..LastChar sans trou) vaut 0
        // via ttfWidthAt -- valide, un glyphe de largeur nulle n'est
        // simplement jamais utilisé.
        Pdf.emitEmbeddedFont(out, offsets, fontF1, descF1, fileF1, 0, "LiberationSans")
        Pdf.emitEmbeddedFont(out, offsets, fontF2, descF2, fileF2, 1, "LiberationSans-Bold")

        // images JPEG
        for i in 0..nImg {
            let im: PdfImage = this.Images.Get(i)
            let imgObj: int = imgBase + i
            offsets.Set(imgObj, out.Count())
            Pdf.putAscii(out, String_FromInt(imgObj) + " 0 obj\n"
                + "<< /Type /XObject /Subtype /Image /Width " + String_FromInt(im.W)
                + " /Height " + String_FromInt(im.H)
                + " /ColorSpace /" + im.Cs + " /BitsPerComponent 8 /Filter /DCTDecode /Length "
                + String_FromInt(im.Data.Count()) + " >>\nstream\n")
            Pdf.putBytes(out, im.Data)
            Pdf.putAscii(out, "\nendstream\nendobj\n")
        }

        // xref
        let xrefPos: int = out.Count()
        Pdf.putAscii(out, "xref\n0 " + String_FromInt(total + 1) + "\n")
        Pdf.putAscii(out, "0000000000 65535 f \n")
        for i in 1..total + 1 {
            Pdf.putAscii(out, Pdf.pad10(offsets.Get(i)) + " 00000 n \n")
        }
        // trailer
        Pdf.putAscii(out, "trailer\n<< /Size " + String_FromInt(total + 1)
            + " /Root 1 0 R >>\nstartxref\n" + String_FromInt(xrefPos) + "\n%%EOF\n")
        return out
    }
}
